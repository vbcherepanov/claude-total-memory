{
  "_comment": "Append the mcpServers and hooks entries below into your existing ~/.claude/settings.json. The installer (~/total-agent-memory/install.sh --ide claude-code) does this automatically, as does the Claude Code plugin (/plugin install total-agent-memory@vbcherepanov).",
  "mcpServers": {
    "memory": {
      "command": "total-agent-memory",
      "args": [],
      "env": {
        "MEMORY_ASYNC_ENRICHMENT": "false",
        "MEMORY_QUALITY_GATE_ENABLED": "auto",
        "MEMORY_CONTRADICTION_DETECT_ENABLED": "auto"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/user-prompt-submit.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/on-stop.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
